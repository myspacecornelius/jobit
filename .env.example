# Job Application AI Agent — environment configuration.
# Copy this file to `.env` and fill in values you want to override.
# Everything is optional; defaults are applied where variables are unset.

# ---------- OpenAI (only needed for CV/cover-letter AI features) ----------
OPENAI_API_KEY=
JOBIT_OPENAI_MODEL=gpt-4o-mini
JOBIT_OPENAI_TEMPERATURE=0.5
JOBIT_OPENAI_MAX_TOKENS=1200

# ---------- Web UI ----------
JOBIT_HOST=127.0.0.1
JOBIT_PORT=5000
JOBIT_DEBUG=false
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Leave blank to auto-generate a random key at startup.
JOBIT_SECRET_KEY=

# ---------- Output directories (absolute or relative paths) ----------
# Parent dir — jobs/ and cvs/ hang off this unless overridden.
JOBIT_OUTPUT_DIR=./outputs
# JOBIT_JOBS_DIR=./outputs/jobs
# JOBIT_CVS_DIR=./outputs/cvs
# JOBIT_UPLOADS_DIR=./outputs/uploads

# ---------- LinkedIn scraper ----------
JOBIT_HEADLESS=true
JOBIT_PAGE_TIMEOUT=20
JOBIT_SCROLL_COUNT=3
JOBIT_SCROLL_PAUSE=2.0
JOBIT_SCROLL_PIXELS=800
JOBIT_MAX_RETRIES=2
JOBIT_RETRY_BACKOFF=2.0
JOBIT_MAX_DAYS_OLD=14

# Selectors are comma-separated fallback lists — the scraper tries each in order.
# Override these when LinkedIn's DOM changes without needing a code release.
# JOBIT_JOB_CARD_SELECTORS=base-card,job-search-card
# JOBIT_TITLE_SELECTORS=h1.topcard__title,h1.top-card-layout__title,h1
# JOBIT_COMPANY_SELECTORS=a.topcard__org-name-link,span.topcard__flavor
# JOBIT_DESCRIPTION_SELECTORS=description__text,show-more-less-html__markup

# Override only if you know you need to (anti-bot evasion, etc.)
# JOBIT_USER_AGENT=
# JOBIT_SEARCH_URL=https://www.linkedin.com/jobs/search?keywords={keyword}&location={location}

# ---------- NLP ----------
JOBIT_SPACY_MODEL=en_core_web_sm
# When true, the CV analyzer downloads the spaCy model on first run if missing.
JOBIT_SPACY_AUTO_DOWNLOAD=false

# ---------- Logging ----------
JOBIT_LOG_LEVEL=INFO
